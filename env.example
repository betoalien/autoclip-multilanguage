# =============================================================================
# AutoClip Multi-Language - Environment Configuration Template
# Copy this file to .env and adjust the parameters for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Database & Cache Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/autoclip.db
REDIS_URL=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: ollama | openai | gemini | siliconflow | dashscope
# -----------------------------------------------------------------------------
# Option 1: Local Offline LLM via Ollama (Recommended: Zero API cost & 100% Privacy)
# Run `ollama run gemma4` or `ollama run qwen2.5`
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
API_OPENAI_API_KEY=ollama
API_MODEL_NAME=gemma4:latest

# Option 2: OpenAI Official
# LLM_PROVIDER=openai
# API_OPENAI_API_KEY=sk-your-openai-key-here
# API_MODEL_NAME=gpt-4o-mini

# Option 3: DeepSeek
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# API_OPENAI_API_KEY=sk-your-deepseek-key-here
# API_MODEL_NAME=deepseek-chat

# Option 4: Google Gemini
# LLM_PROVIDER=gemini
# API_GEMINI_API_KEY=your-gemini-api-key-here
# API_MODEL_NAME=gemini-1.5-flash

# Option 5: DashScope (Qwen Alibaba Cloud)
# LLM_PROVIDER=dashscope
# API_DASHSCOPE_API_KEY=your_dashscope_api_key_here
# API_MODEL_NAME=qwen-plus

API_MAX_TOKENS=4096
API_TIMEOUT=60

# -----------------------------------------------------------------------------
# Video Processing & Reel Clipping Configuration
# -----------------------------------------------------------------------------
# Chunk size for LLM subtitle transcript analysis (characters)
PROCESSING_CHUNK_SIZE=5000

# Minimum relevance score to qualify as a highlight (0.0 to 1.0)
PROCESSING_MIN_SCORE_THRESHOLD=0.7

# Maximum number of short clips to produce per collection
PROCESSING_MAX_CLIPS_PER_COLLECTION=5

# Maximum retry attempts for failed processing stages
PROCESSING_MAX_RETRIES=3

# Subtitle and video duration target for short-form clips (in seconds)
TARGET_CLIP_MIN_DURATION=45
TARGET_CLIP_MAX_DURATION=90

# -----------------------------------------------------------------------------
# YouTube & Video Downloader Configuration
# -----------------------------------------------------------------------------
# Preferred subtitle languages requested from YouTube (comma-separated)
AUTOCLIP_YT_SUBTITLE_LANGS=es,es-orig,en,zh-Hans

# Player client fallback for yt-dlp (e.g., android, ios, tv)
# AUTOCLIP_YT_CLIENT=android

# -----------------------------------------------------------------------------
# Application Environment & Logging
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
AUTOCLIP_DESKTOP_MODE=true

LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE=backend.log
